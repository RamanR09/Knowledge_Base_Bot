# --- Database ---
DATABASE_URL=postgres://kbchat:kbchat_dev_password@localhost:5432/kbchat

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Google OAuth (email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict ALL new sign-ups (email/password AND Google) to this
# email domain, e.g. "example.com". Leave empty to allow any email.
GOOGLE_ALLOWED_DOMAIN=

# --- AI providers (server-side only; never NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
FIRECRAWL_API_KEY=

# --- Storage ---
UPLOAD_DIR=./data/uploads
